# ===== 应用 =====
APP_NAME=ResearchMate
SECRET_KEY=please-change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== 单用户自动登录（本地部署建议开启，跳过登录页）=====
AUTO_LOGIN=true
AUTO_LOGIN_USERNAME=researcher
AUTO_LOGIN_PASSWORD=researchmate

# ===== 数据库（默认本地 SQLite 单文件，零配置）=====
# 如需换路径：DATABASE_URL=sqlite:///./researchmate.db
DATABASE_URL=sqlite:///./researchmate.db

# ===== 文件存储 =====
STORAGE_DIR=storage
PDF_DIR=storage/pdfs

# ===== 前端静态目录（构建后的前端 dist；绿色包/单端口模式启用）=====
# FRONTEND_DIST=../frontend/dist

# ===== LLM（OpenAI 兼容接口；运行时可在「设置」页覆盖）=====
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ===== 翻译（可选 DeepL 兜底）=====
DEEPL_API_KEY=

# ===== CORS（前端开发端口）=====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 科研 Skill 模块（LLM 提供方）=====
# 提供方：ollama | openai | mock | auto
RESEARCH_LLM_PROVIDER=auto
# 本地 Ollama
RESEARCH_OLLAMA_BASE_URL=http://localhost:11434
RESEARCH_OLLAMA_MODEL=llama3
# OpenAI 兼容
RESEARCH_OPENAI_API_KEY=${LLM_API_KEY}
RESEARCH_OPENAI_BASE_URL=${LLM_BASE_URL}
RESEARCH_OPENAI_MODEL=${LLM_MODEL}
# 科研产物输出目录（默认 <运行目录>/output）
# RESEARCH_OUTPUT_DIR=./output